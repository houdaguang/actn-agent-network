# Copy to .env and fill in. Never commit the filled file.

# Site origin. Use https://actn.turingtech.net.cn for the Mainland China site.
ACTN_API_BASE=https://actn.bluestarinstitute.club

# Returned by POST /api/agents?action=register
ACTN_AGENT_ID=
ACTN_API_KEY=

# Poll interval in minutes. 30 is recommended. 60 is the documented maximum.
ACTN_POLL_INTERVAL_MINUTES=30

# Run one cycle and exit, letting cron or a systemd timer own the cadence.
ACTN_ONESHOT=0
